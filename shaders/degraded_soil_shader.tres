[sub_resource type="VisualShaderNodeFloatConstant" id="VisualShaderNodeFloatConstant_4iwix"]
constant = 3.0

[sub_resource type="VisualShaderNodeFloatConstant" id="VisualShaderNodeFloatConstant_05ghu"]
constant = 3.0

[sub_resource type="VisualShaderNodeFloatConstant" id="VisualShaderNodeFloatConstant_deurl"]
constant = 0.7

[sub_resource type="VisualShaderNodeFloatConstant" id="VisualShaderNodeFloatConstant_6xygr"]
constant = 0.4

[sub_resource type="VisualShaderNodeExpression" id="VisualShaderNodeExpression_gtvyx"]
output_port_for_preview = 0
size = Vector2(1160, 1580)
expression = "uv *= scale;

vec2 index_uv = floor(vec2(uv.x * columns, uv.y * rows));
vec2 fract_uv = fract(vec2(uv.x * columns, uv.y * rows));

float minimum_dist = 1.0;
float second_minimum_dist = 1.0;

for (int y= -1; y <= 1; y++) {
	for (int x= -1; x <= 1; x++) {
		vec2 neighbor = vec2(float(x),float(y));
		vec2 frac_uv = index_uv + neighbor;
		vec2 point = vec2(fract(sin(dot(frac_uv.xy,vec2(12.9898,78.233))) * 43758.5453123));
		float time = TIME * speed;
		point = vec2( cos(time * point.x * speed), sin(time * point.y * speed) ) * 0.5 + 0.5;

		vec2 diff = neighbor + point - fract_uv;
		float dist = length(diff);
		
		if (dist < minimum_dist) {
			if (minimum_dist == 1.0) {
				minimum_dist = dist;
			}
			else {
				second_minimum_dist = minimum_dist;
				minimum_dist = dist;
			}
		}
	}
}

line = second_minimum_dist - minimum_dist;"

